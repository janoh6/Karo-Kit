<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	>
	<testsuites>
		<testsuite name="karo-kit">
			<directory prefix="test-" suffix=".php">./tests/</directory>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<!-- Forks real processes; run explicitly via the concurrency test group. -->
			<group>concurrency</group>
		</exclude>
	</groups>
</phpunit>
